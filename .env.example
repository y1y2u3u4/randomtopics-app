# Speech practice: fill only this project's own service credentials.
NEXT_PUBLIC_SPEECH_COACH_ENABLED=false
SPEECH_COACH_ENABLED=false
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=

# Enable after the sender domain and custom SMTP are configured.
# Recipient delivery/recovery verification is a rollout check, not an owner approval gate.
SPEECH_EMAIL_ENABLED=false

# Dedicated RandomTopics Stripe config. Generic STRIPE_* keys are not used.
# Prefer a NEW rk_test_ restricted key for this service; never reuse FlashcardMaker's key.
SPEECH_STRIPE_SECRET_KEY=
SPEECH_STRIPE_WEBHOOK_SECRET=
SPEECH_STRIPE_PRODUCT_ID=
SPEECH_STRIPE_PRICE_ID=
SPEECH_STRIPE_PORTAL_CONFIGURATION_ID=
SPEECH_SITE_URL=
SPEECH_BILLING_ENABLED=false
SPEECH_LIVE_BILLING_ENABLED=false
